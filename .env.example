# ────────────────────────────────────────────────────────────────────
# JJMMC ERP — environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ────────────────────────────────────────────────────────────────────

# Port the Express server listens on (optional, defaults to 3000)
PORT=3000

# Session cookie secret (change in production)
SESSION_SECRET=replace-me-with-a-long-random-string

# ────────────────────────────────────────────────────────────────────
# Firebase credentials — pick ONE of the three options below.
# ────────────────────────────────────────────────────────────────────

# OPTION A — easiest on Windows / local dev:
#   Point to a service-account JSON file on disk.
# GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\jjmmc-erp-firebase-admin.json

# OPTION B — paste the entire JSON as a single line
#   (wrap it in single quotes; escape nothing inside).
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"..."}'

# OPTION C — three discrete values (good for Vercel / CI):
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
